# Copy this file to .env and fill in real values. Never commit .env.

# Backend API base URL (no trailing /api — that's added automatically)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase (Auth: OTP, Google, Phone) — anon/public key only, never service_role
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON=your-anon-public-key

# Web origin used to build shareable invite links (QR codes, share sheet).
# Must match the backend's FRONTEND_URL so QR codes generated by the API and
# links built client-side point to the same place.
EXPO_PUBLIC_APP_URL=https://merizo-app.onrender.com

# Optional — Logo.dev "name" endpoint (recurring.tsx). Publishable key only,
# safe for client-side use per Logo.dev's docs. Without it, unrecognized
# subscriptions just fall back to the pin emoji.
EXPO_PUBLIC_LOGO_DEV_TOKEN=
