{
  "expo": {
    "name": "Merizo",
    "slug": "merizo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "frontend",
      "merizo"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan bills and invite QR codes",
        "NSPhotoLibraryUsageDescription": "Pick a bill photo to log an expense"
      },
      "bundleIdentifier": "com.raghu30.merizo"
    },
    "android": {
      "package": "com.raghu30.merizo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8E4DB"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan bills and invite QR codes"
        }
      ],
      "./plugins/withAndroidSpeechRecognizer.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92ab9f33-13cd-4cf5-bb73-8676a7d35f10"
      }
    },
    "owner": "mahesh_05"
  }
}
