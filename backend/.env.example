# Copy this file to .env and fill in real values. Never commit .env.

# ── Required — server won't start without these ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key   # service_role, NOT anon — server-side only
JWT_SECRET=change-me-to-a-long-random-string

# ── Invite links (QR codes, share sheet) ────────────────────────────────────
# Web origin used to build shareable /join/{token} links. Must match the
# frontend's EXPO_PUBLIC_APP_URL.
FRONTEND_URL=https://merizo-app.onrender.com

# ── Optional — demo account ─────────────────────────────────────────────────
DEMO_EMAIL=demo@merizo.app
DEMO_PASSWORD=Demo@123
DEMO_NAME=Demo User

# ── Optional — AI features (chat, receipt parsing, insights) ───────────────
GEMINI_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
EMERGENT_LLM_KEY=
SARVAM_API_KEY=

# Google Cloud Vision (OCR for bill scanning — printed + handwritten receipts)
GOOGLE_CLOUD_VISION_API_KEY=

# Reserved for future Google Cloud API use. NOTE: Gmail-address verification
# does NOT use this key — Google has no API-key-only endpoint for that, so
# /auth/register verifies addresses via a DNS MX-record lookup instead
# (see verify_email_domain() in server.py). "Sign in with Google" also does
# NOT use this key — that needs an OAuth Client ID/Secret configured in the
# Supabase dashboard (Authentication > Providers > Google), not an API key.
GOOGLE_API_KEY=

# ── Optional — SMS / email validation providers ─────────────────────────────
FAST2SMS_API_KEY=
MAILBOXLAYER_KEY=

# ── SMTP — emails the OTP codes for register/delete-account verification.
# Without these set, codes are only logged server-side (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

PORT=8000
